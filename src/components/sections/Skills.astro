---
import { BrainIcon, Code2Icon, DatabaseIcon, BarChart3Icon, FlaskConicalIcon, FlameIcon, ScanEyeIcon, NetworkIcon, WorkflowIcon, ServerIcon, GitBranchIcon, TerminalIcon, LineChartIcon, FileSpreadsheetIcon, GithubIcon, ZapIcon, ContainerIcon, CalculatorIcon } from '@lucide/astro';

import { t } from '../../utils/i18n';

interface Props {
  lang: string | undefined;
}

const { lang } = Astro.props;

const skillClusters = [
  {
    id: 'ai-ml',
    title: t('skills.clusters.aiMl.title', lang),
    description: t('skills.clusters.aiMl.description', lang),
    icon: BrainIcon,
    tools: [
      { name: 'Python', icon: TerminalIcon },
      { name: 'PyTorch', icon: FlameIcon },
      { name: 'Scikit-learn', icon: FlaskConicalIcon },
      { name: 'YOLO', icon: ScanEyeIcon },
      { name: 'LLMs', icon: BrainIcon },
      { name: 'RAG', icon: NetworkIcon },
      { name: 'LangChain', icon: WorkflowIcon },
    ]
  },
  {
    id: 'data-infrastructure',
    title: t('skills.clusters.dataInfrastructure.title', lang),
    description: t('skills.clusters.dataInfrastructure.description', lang),
    icon: DatabaseIcon,
    tools: [
      { name: 'SQL', icon: DatabaseIcon },
      { name: 'PostgreSQL', icon: ServerIcon },
      { name: 'BigQuery', icon: DatabaseIcon },
      { name: 'Qdrant', icon: ServerIcon },
      { name: 'dbt', icon: WorkflowIcon },
      { name: 'Airflow', icon: WorkflowIcon },
      { name: 'Selenium', icon: TerminalIcon },
    ]
  },
  {
    id: 'data-analytics',
    title: t('skills.clusters.dataAnalytics.title', lang),
    description: t('skills.clusters.dataAnalytics.description', lang),
    icon: BarChart3Icon,
    tools: [
      { name: 'Pandas', icon: FileSpreadsheetIcon },
      { name: 'NumPy', icon: CalculatorIcon },
      { name: 'Matplotlib', icon: LineChartIcon },
      { name: 'Looker Studio', icon: BarChart3Icon },
      { name: 'EDA', icon: BarChart3Icon },
    ]
  },
  {
    id: 'deployment-tools',
    title: t('skills.clusters.deploymentTools.title', lang),
    description: t('skills.clusters.deploymentTools.description', lang),
    icon: Code2Icon,
    tools: [
      { name: 'FastAPI', icon: ZapIcon },
      { name: 'Docker', icon: ContainerIcon },
      { name: 'Git', icon: GithubIcon },
      { name: 'GitHub Actions', icon: GitBranchIcon },
      { name: 'Linux', icon: TerminalIcon },
    ]
  }
];
---

<section id="skills" class="py-16 md:py-24">
  <div class="max-w-container mx-auto px-6">
    <div class="mb-8 md:mb-10 text-center" data-aos="fade-up" data-aos-duration="800">
      <h2 class="font-heading text-h2 text-secondary dark:text-white mb-4">{t('skills.title', lang)}</h2>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 md:gap-8">
      {skillClusters.map((cluster, index) => (
        <div
          id={cluster.id}
          class="skill-cluster bg-white dark:bg-neutral-dark border border-gray-100 dark:border-gray-800 rounded-xl p-6 shadow-sm hover:shadow-md transition-all duration-300"
          data-aos="fade-up"
          data-aos-duration="600"
          data-aos-delay={index * 150}
        >
          <div class="cluster-header flex items-center mb-4">
            <div class="icon-container mr-4 text-primary bg-primary/5 p-3 rounded-lg">
              {/* SVG for Cluster Icon with specific paths */}
              <cluster.icon size=26 stroke-width=1.75 />
            </div>
            <h3 class="font-heading text-xl text-secondary dark:text-white">
              {cluster.title}
            </h3>
          </div>

          <p class="text-secondary/70 dark:text-white/70 mb-4 cluster-description">
            {cluster.description}
          </p>

          <div class="cluster-tools grid grid-cols-2 sm:grid-cols-3 gap-4 mt-6">
            {cluster.tools.map((tool) => (
              <div class="tool-item flex flex-col items-center text-center">
                <div class="tool-icon text-primary bg-primary/5 p-3 rounded-lg mb-2">
                  <tool.icon size=20 stroke-width=1.75 />
                </div>
                <p class="text-sm font-medium text-secondary dark:text-white">{tool.name}</p>
              </div>
            ))}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>