---
import Obfuscate from 'react-obfuscate';

import { t } from '../../utils/i18n';
import { email, github_short, github_url, linkedin_short, linkedin_url } from '../../utils/me';

interface Props {
  lang: string | undefined;
}

const { lang } = Astro.props;
---

<section id="contact" class="py-16 md:py-24 bg-neutral-bg dark:bg-neutral-dark/60">
  <div class="max-w-container mx-auto px-6">
    <div class="mb-12 text-center" data-aos="fade-up">
      <h2 class="font-heading text-h2 text-secondary dark:text-white mb-4">
        {t('contact.title', lang)}
      </h2>
      <p class="text-secondary/70 dark:text-white/70 max-w-2xl mx-auto">
        {t('contact.subtitle', lang)}
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      <!-- Email Card -->
      <Obfuscate
        email={email}
        obfuscateChildren={false}
        client:only="preact"
        className="group bg-gray-50 dark:bg-white/5 backdrop-blur-sm border border-gray-100 dark:border-white/10 rounded-xl p-8 text-center hover:bg-gray-100 dark:hover:bg-white/10 transition-all duration-300 transform hover:scale-105 hover:shadow-lg"
        data-aos="fade-up"
        data-aos-delay="100"
      >
        <div class="relative w-16 h-16 mx-auto mb-6 bg-primary/20 rounded-full flex items-center justify-center">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="28"
            height="28"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.75"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="text-primary"
            role="img"
            aria-labelledby="emailContactIconTitle"
          >
            <title id="emailContactIconTitle">
              {t('contact.emailTitle', lang)} Icon
            </title>
            <rect width="20" height="16" x="2" y="4" rx="2"></rect>
            <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>
          </svg>
        </div>

        <h3 class="font-heading text-xl text-secondary dark:text-white mb-3">
          {t('contact.emailTitle', lang)}
        </h3>
        <p class="text-secondary/70 dark:text-white/70 mb-4">
          <Obfuscate element="span" email={email} client:only="preact" />
        </p>
        <span class="inline-flex items-center text-sm text-primary font-medium">
          <span>{t('contact.emailButtonText', lang)}</span>
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="ml-1"
            role="img"
            aria-labelledby="emailArrowIconTitle"
          >
            <title id="emailArrowIconTitle">
              {t('contact.emailButtonText', lang)} Arrow
            </title>
            <path d="M5 12h14"></path>
            <path d="m12 5 7 7-7 7"></path>
          </svg>
        </span>
      </Obfuscate>

      <!-- GitHub Card -->
      <a
        href={github_url}
        target="_blank"
        rel="noopener noreferrer"
        class="group bg-gray-50 dark:bg-white/5 backdrop-blur-sm border border-gray-100 dark:border-white/10 rounded-xl p-8 text-center hover:bg-gray-100 dark:hover:bg-white/10 transition-all duration-300 transform hover:scale-105 hover:shadow-lg"
        data-aos="fade-up"
        data-aos-delay="200"
      >
        <div class="w-16 h-16 mx-auto mb-6 bg-primary/20 rounded-full flex items-center justify-center">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="28"
            height="28"
            viewBox="0 0 24 24"
            fill="currentColor"
            class="text-primary"
            role="img"
            aria-labelledby="githubContactIconTitle"
          >
            <title id="githubContactIconTitle">
              {t('contact.githubTitle', lang)} Icon
            </title>
            <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/>
          </svg>
        </div>

        <h3 class="font-heading text-xl text-secondary dark:text-white mb-3">
          {t('contact.githubTitle', lang)}
        </h3>
        <p class="text-secondary/70 dark:text-white/70 mb-4">
          {github_short}
        </p>
        <span class="inline-flex items-center text-sm text-primary font-medium">
          {t('contact.githubButtonText', lang)}
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="ml-1"
            role="img"
            aria-labelledby="githubArrowIconTitle"
          >
            <title id="githubArrowIconTitle">
              {t('contact.githubButtonText', lang)} Arrow
            </title>
            <path d="M5 12h14"></path>
            <path d="m12 5 7 7-7 7"></path>
          </svg>
        </span>
      </a>

      <!-- LinkedIn Card -->
      <a
        href={linkedin_url}
        target="_blank"
        rel="noopener noreferrer"
        class="group bg-gray-50 dark:bg-white/5 backdrop-blur-sm border border-gray-100 dark:border-white/10 rounded-xl p-8 text-center hover:bg-gray-100 dark:hover:bg-white/10 transition-all duration-300 transform hover:scale-105 hover:shadow-lg"
        data-aos="fade-up"
        data-aos-delay="300"
      >
        <div
          class="w-16 h-16 mx-auto mb-6 bg-primary/20 rounded-full flex items-center justify-center"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="28"
            height="28"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.75"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="text-primary"
            role="img"
            aria-labelledby="linkedinContactIconTitle"
          >
            <title id="linkedinContactIconTitle">
              {t('contact.linkedinTitle', lang)} Icon
            </title>
            <path
              d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"
            ></path>
            <rect width="4" height="12" x="2" y="9"></rect>
            <circle cx="4" cy="4" r="2"></circle>
          </svg>
        </div>

        <h3 class="font-heading text-xl text-secondary dark:text-white mb-3">
          {t('contact.linkedinTitle', lang)}
        </h3>
        <p class="text-secondary/70 dark:text-white/70 mb-4">
          {linkedin_short}
        </p>
        <span class="inline-flex items-center text-sm text-primary font-medium">
          {t('contact.linkedinButtonText', lang)}
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="ml-1"
            role="img"
            aria-labelledby="linkedinArrowIconTitle"
          >
            <title id="linkedinArrowIconTitle">
              {t('contact.linkedinButtonText', lang)} Arrow
            </title>
            <path d="M5 12h14"></path>
            <path d="m12 5 7 7-7 7"></path>
          </svg>
        </span>
      </a>
    </div>
  </div>
</section>
