---
import { t } from '../../utils/i18n';
import { Image } from 'astro:assets';
import profileImg from '../../assets/profile.png';

const lang = Astro.currentLocale;
---

<section id="start" class="relative min-h-screen flex items-center pt-28 pb-16 overflow-hidden">
  <div class="absolute top-1/2 right-0 -translate-y-1/2 w-[600px] h-[600px] bg-primary/15 dark:bg-primary/20 blur-[120px] rounded-full -z-10 pointer-events-none"></div>

  <div class="max-w-container mx-auto px-6 w-full">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-gutter items-center">
      <div class="md:col-span-6 flex flex-col justify-center">
        <span class="font-mono text-secondary/50 dark:text-white/50 text-xs tracking-[0.25em] uppercase mb-4">
          {t('hero.greeting', lang)}
        </span>

        <h1 class="font-heading text-5xl md:text-7xl lg:text-8xl text-secondary dark:text-white mb-4 tracking-tight">
          {t('hero.name', lang)}
        </h1>

        <p class="font-mono text-secondary/70 dark:text-white/70 text-sm mb-6">
          {t('hero.role', lang)}
        </p>

        <p class="text-lg md:text-xl text-secondary/80 dark:text-white/80 mb-10 max-w-2xl">
          {t('hero.pitch', lang)}
        </p>

        <p class="font-mono text-primary text-sm md:text-base mb-8">
          {t('hero.focusAreas', lang)}
        </p>

        <div class="flex flex-col sm:flex-row gap-4 mb-8">
          <a
            href="#about"
            class="inline-flex items-center justify-center rounded-lg font-semibold text-base py-3.5 px-7 bg-primary text-white hover:bg-primary/90 transition-colors shadow-lg shadow-primary/20"
          >
            {t('hero.ctaAbout', lang)}
          </a>
          <a
            href="#projects"
            class="inline-flex items-center justify-center rounded-lg font-semibold text-base py-3.5 px-7 border border-primary text-primary hover:bg-primary/10 bg-transparent transition-colors"
          >
            {t('hero.ctaPortfolio', lang)}
          </a>
        </div>

        <div class="flex flex-wrap items-center gap-x-8 gap-y-3 pt-6 border-t border-secondary/10 dark:border-white/10 w-full">
          <div class="flex items-center gap-3">
            <div class="text-3xl font-heading text-secondary dark:text-white">10+</div>
            <div class="text-sm text-secondary/60 dark:text-white/60 font-mono">{t('hero.statsProjects', lang)}</div>
          </div>
          <div class="flex items-center gap-2">
            <span class="h-3 w-3 rounded-full bg-green-500 ring-4 ring-green-500/20 shadow-[0_0_12px_2px_rgba(34,197,94,0.5)] animate-pulse"></span>
            <span class="text-sm text-secondary/60 dark:text-white/60 font-mono">{t('hero.openToWork', lang)}</span>
          </div>
        </div>
      </div>

      <div class="md:col-span-6 mt-12 md:mt-0 flex justify-center">
        <div class="relative">
          <div class="absolute inset-0 rounded-2xl bg-gradient-to-br from-primary/50 via-primary/20 to-transparent blur-3xl scale-110 -z-10"></div>

          <Image
            src={profileImg}
            alt={t('hero.name', lang)}
            class="w-full max-w-lg mx-auto rounded-2xl ring-2 ring-white/20 shadow-2xl shadow-primary/25"
            width="500"
            height="600"
            loading="eager"
            fetchpriority="high"
          />
        </div>
      </div>
    </div>
  </div>

  <button
    id="scroll-indicator"
    type="button"
    aria-label="Scroll to about section"
    class="absolute bottom-8 left-1/2 -translate-x-1/2 text-primary dark:text-highlightBlue cursor-pointer"
    onclick="document.getElementById('about')?.scrollIntoView({ behavior: 'smooth' });"
  >
    <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M12 5v14"></path>
      <path d="m19 12-7 7-7-7"></path>
    </svg>
  </button>
</section>

<style>
  @keyframes scroll-bounce {
    0%, 100% { transform: translate(-50%, 0); }
    50% { transform: translate(-50%, 8px); }
  }

  #scroll-indicator {
    animation: scroll-bounce 2s ease-in-out infinite;
  }
</style>