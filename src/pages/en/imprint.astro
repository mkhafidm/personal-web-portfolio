---
import Layout from '../../layouts/Layout.astro';
import { t } from '../../utils/i18n';
import { name, email, github_url, linkedin_url, github_short, linkedin_short } from '../../utils/me';

const lang = 'en'; // Explicitly English for this page
const pageTitle = "Imprint | " + t('site.title', lang);
const pageDescription = "Imprint of the website " + t('site.title', lang);
---

<Layout title={pageTitle} description={pageDescription} lang={lang}>
  <section class="py-16 md:py-24">
    <div class="max-w-container mx-auto px-6">
      <header class="mb-12 text-center">
        <h1 class="font-heading text-h1 text-secondary dark:text-white">Imprint</h1>
      </header>

      <article class="prose dark:prose-invert max-w-none mx-auto bg-white dark:bg-neutral-dark p-6 md:p-8 rounded-lg shadow">
        <h2>Site Owner &amp; Responsibility</h2>
        <p>
          <strong>{name}</strong><br />
          AI Engineer &amp; Data Specialist<br />
          Surabaya / Mojokerto, East Java, Indonesia
        </p>

        <h2>Contact Information</h2>
        <ul>
          <li><strong>Email:</strong> <a href={`mailto:${email}`}>{email}</a></li>
          <li><strong>GitHub:</strong> <a href={github_url} target="_blank" rel="noopener noreferrer">{github_short}</a></li>
          <li><strong>LinkedIn:</strong> <a href={linkedin_url} target="_blank" rel="noopener noreferrer">{linkedin_short}</a></li>
        </ul>

        <h2>Purpose of Website</h2>
        <p>This is a personal portfolio website showcasing professional projects, technical articles, and background information regarding my work in AI engineering and data solutions. All content, code repositories, and design layouts presented here reflect my personal work unless stated otherwise.</p>
      </article>
    </div>
  </section>
</Layout>