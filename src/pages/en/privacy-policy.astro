---
import Layout from '../../layouts/Layout.astro';
import { t } from '../../utils/i18n';
import { name, email } from '../../utils/me';

const lang = 'en'; // Explicitly English for this page
const pageTitle = "Privacy Policy | " + t('site.title', lang);
const pageDescription = "Privacy Policy of the website " + t('site.title', lang);
---

<Layout title={pageTitle} description={pageDescription} lang={lang}>
  <section class="py-16 md:py-24">
    <div class="max-w-container mx-auto px-6">
      <header class="mb-12 text-center">
        <h1 class="font-heading text-h1 text-secondary dark:text-white">Privacy Policy</h1>
      </header>

      <article class="prose dark:prose-invert max-w-none mx-auto bg-white dark:bg-neutral-dark p-6 md:p-8 rounded-lg shadow">
        <p><strong>Effective date:</strong> September 17, 2026</p>
        <p>This personal portfolio website (https://mkhafidm.github.io / custom domain) is operated by {name}.</p>
        <p>I respect your privacy and am committed to protecting any information you might share when visiting this site.</p>

        <h2>Data Collection</h2>
        <ul>
          <li><strong>No Active Data Tracking:</strong> This website does not track personal data, use intrusive third-party trackers, or require user accounts/registration.</li>
          <li><strong>Direct Communication:</strong> If you choose to contact me via email (using the <code>mailto</code> links) or connect via LinkedIn/GitHub, you are voluntarily sharing your contact information. This data is only used to respond to your inquiries or professional proposals.</li>
          <li><strong>Hosting &amp; Analytics:</strong> This site is hosted on static deployment platforms that may collect standard, anonymous server logs (such as IP addresses and browser types) strictly for performance and security purposes.</li>
        </ul>

        <h2>External Links</h2>
        <p>This website contains external links to GitHub and LinkedIn. I am not responsible for the privacy practices or content of those external platforms.</p>

        <h2>Contact</h2>
        <p>If you have any questions regarding this privacy policy, feel free to reach out directly via email at <a href={`mailto:${email}`}>{email}</a>.</p>
      </article>
    </div>
  </section>
</Layout>